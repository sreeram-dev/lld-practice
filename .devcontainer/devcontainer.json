{
  "name": "LLD Practice",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.15-bookworm",
  "remoteUser": "vscode",
  "postCreateCommand": "python -m pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ],
      "settings": {
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": [
          "tests"
        ],
        "python.analysis.extraPaths": [
          "${containerWorkspaceFolder}/src"
        ]
      }
    }
  }
}
